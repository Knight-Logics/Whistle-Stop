{
  // Whistle Stop Grill & Bar — Cloudflare Worker (static site + staff admin API)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whistle-stop",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    // The Worker decides routing itself so URLs stay identical to the GitHub Pages version (*.html).
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  // Published content, photos, staff logins and form messages. Created automatically on first deploy.
  "kv_namespaces": [{ "binding": "CONTENT" }],
  // Keep variables set in the Cloudflare dashboard (e.g. TURNSTILE_SITE_KEY, Access settings).
  "keep_vars": true,
  "observability": { "enabled": true }
}
